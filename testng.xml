<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Suite">

    <parameter name="url" value="https://adactinhotelapp.com/index.php"></parameter>
    <test thread-count="5" name="Regression Test"  >
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="TestCases.T3_RegressionTest"/>
        </classes>
    </test>

    <test thread-count="5" name="Smoke Test"  >
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="TestCases.T4_CancelBookingTest"/>
        </classes>
    </test>

    <test thread-count="5" name="Validation Test"  >
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="TestCases.T2_CSInvalidLoginTest"/>
        </classes>
    </test>
</suite>